<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>cs-route-trie</AssemblyName>
    <RootNamespace>route_trie</RootNamespace>
    <Description>URL router with radix trie (Kestrel-style route matching)</Description>
    <Authors>Mahmoud ElNemer</Authors>
    <PackageProjectUrl>https://github.com/ElNeMeR70/cs-route-trie</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ElNeMeR70/cs-route-trie</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
